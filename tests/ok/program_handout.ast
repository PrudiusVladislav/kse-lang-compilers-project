Program
  Struct Point
    Field x i32 mut
    Field y i32 mut
  Struct Circle
    Field center Point const
    Field radius i32 mut
  Fn add -> i32
    Param a i32
    Param b i32
    Block
      Decl sum i32 const
        BinOp +
          Var a
          Var b
      Exit
        Var sum
  Fn isXZero -> bool
    Param p Point
    Block
      Decl zero bool const
        BinOp ==
          FieldAccess p.x
          Const 0
      Exit
        Var zero
  Fn moved -> Point
    Param p Point
    Param dx i32
    Block
      Decl q Point const
        BinOp +
          FieldAccess p.x
          Var dx
        FieldAccess p.y
      Exit
        Var q
  Decl p Point const
    Const 10
    Const 20
  Decl c Circle const
    Var p
    Const 5
  Decl xCoord i32 const
    FieldAccess c.center.x
  Decl z bool const
    Call isXZero
      Var p
  Decl r Point mut
    Call moved
      Var p
      Const 1
  Assign r
    Call moved
      Var r
      Const 2
  Decl result i32 const
    Call add
      Var xCoord
      Call add
        FieldAccess r.x
        FieldAccess c.radius
  Exit
    Var result
